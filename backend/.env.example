# Database Configuration
DATABASE_URL=postgresql://username:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# Frontend URL (for CORS)
FRONTEND_URL=https://your-app.vercel.app

# Admin login (required for /admin). JWT_SECRET: a long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Email via Resend. RESEND_FROM must be on a domain verified in Resend (e.g. noreply@kewinchem.com);
# without it only the Resend account owner receives mail and requester copies are skipped.
RESEND_API_KEY=
RESEND_FROM=Kewin Chemicals <noreply@kewinchem.com>
SAMPLE_REQUEST_TO=
INQUIRY_TO=
