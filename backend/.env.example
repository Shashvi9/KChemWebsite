# Database Configuration
DATABASE_URL=postgresql://username:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# Frontend URL (for CORS)
FRONTEND_URL=https://your-app.vercel.app

# Admin login throttle configuration
# First failed login gets the base delay, repeated failures double until the max delay cap,
# state expires after retention seconds, and the in-memory map stays bounded by max buckets.
ADMIN_LOGIN_THROTTLE_BASE_DELAY_SECONDS=1
ADMIN_LOGIN_THROTTLE_MAX_DELAY_SECONDS=300
ADMIN_LOGIN_THROTTLE_RETENTION_SECONDS=900
ADMIN_LOGIN_THROTTLE_MAX_BUCKETS=10000

# Optional: Email configuration (if using email features)
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-app-password
# MAIL_FROM=your-email@gmail.com
# MAIL_PORT=587
# MAIL_SERVER=smtp.gmail.com
